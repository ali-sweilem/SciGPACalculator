<Application x:Class="GpaCalculator.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GpaCalculator.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <converters:CgpaToColorConverter x:Key="CgpaToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- ===== الألوان الأساسية - عدّل هنا بس لو حبيت تغيّر مظهر البرنامج كله ===== -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2E5EAA"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1F4483"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#DADADA"/>
            <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EAF4FF"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#E67E22"/>

            <!-- ===== أزرار ===== -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            </Style>

            <!-- زرار صغير (زي X الحذف جوه الجداول) -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="6,1"/>
            </Style>

            <!-- ===== نصوص ===== -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.65"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.55"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,50,0,0"/>
            </Style>

            <!-- ===== أعمدة الأرقام (اتجاه ثابت من الشمال لليمين + Tooltip الخطأ) ===== -->
            <Style x:Key="NumericDisplayStyle" TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="TextAlignment" Value="Left"/>
            </Style>

            <Style x:Key="NumericEditStyle" TargetType="TextBox">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip"
                                Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== بطاقات (Border) ===== -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="ResultBoxStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
