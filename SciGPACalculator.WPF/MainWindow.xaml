<Window x:Class="GpaCalculator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GpaCalculator.WPF.Views"
        Title="حاسبة المعدل التراكمي"
        Icon="Resources/app-icon.ico"
        Height="650" Width="950"
        FlowDirection="RightToLeft">
    <TabControl>
        <TabItem Header="الحساب والنتائج">
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>
        <TabItem Header="إدخال البيانات">
            <views:DataEntryView DataContext="{Binding DataEntry}" />
        </TabItem>
        <TabItem Header="حول البرنامج">
            <views:AboutView />
        </TabItem>
    </TabControl>
</Window>
